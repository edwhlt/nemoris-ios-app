# Xcode
DerivedData/
.derivedData/
.build/
# Un motif contenant une barre oblique est ancré à la racine du dépôt : la forme
# `*.xcworkspace/xcuserdata/` ne pouvait donc pas atteindre le xcuserdata niché
# sous Nemoris.xcodeproj/project.xcworkspace/. Le préfixe `**/` lève l'ancrage.
**/xcuserdata/
*.xcuserstate

# macOS
.DS_Store

# Produits de build locaux (xcodebuild -derivedDataPath / build)
build/

# Données bancaires réelles — ne doivent JAMAIS être commitées.
#
# Le corpus de test (Tests/Fixtures/merchant_labels_corpus.json) est la version
# ASSAINIE : noms de personnes anonymisés et identifiants numériques substitués
# par build_corpus.py. Le CSV source, lui, contient de vrais libellés de compte
# et reste hors du dépôt.
*personal*.csv
*releve*.csv
*.sqlite
*.sqlite-shm
*.sqlite-wal
